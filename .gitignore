# İzin listesi: yalnızca aşağıda adı geçenler depoya girer. Deney, kaynaklar, devir notları
# ve yeni açılan her şey varsayılan olarak dışarıda kalır; kazara yayımlanamaz.
/*
!/.gitignore
!/LICENSE
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/tests/
!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/config/
/config/*
!/config/mayen.yaml.example
!/config/prompts/
!/panel/
!/desktop/
!/services/
/services/*
!/services/stt/
!/services/tts/
!/services/speaker/
/services/*/*
!/services/*/main.py
!/services/*/pyproject.toml
!/services/*/uv.lock
!/services/*/*.yaml.example
!/services/stt/wake/
/services/stt/wake/*
!/services/stt/wake/hey_mayen.onnx
!/android/
/android/*
!/android/build.gradle.kts
!/android/settings.gradle.kts
!/android/gradle.properties
!/android/gradlew
!/android/gradlew.bat
!/android/gradle/
!/android/src/

__pycache__/
