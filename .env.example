# Bu dosya depoya girer, `.env` girmez.
# Kullanım: kopyala, doldur, `uv run --env-file .env ...` ile koş.

# Kayıt düzeyi: DEBUG | INFO | WARNING | ERROR | CRITICAL
MAYEN_LOG_LEVEL=INFO

# Kayıt biçimi: geliştirmede konsol (false), işletimde JSON (true)
MAYEN_LOG_JSON=false

# Hava durumu (§19.7). Anahtar buraya, asla koda veya depoya.
MAYEN_OPENWEATHERMAP_KEY=

# Veritabanı: tek dosya, tek sahip (§16).
MAYEN_DB_PATH=mayen.db

# Yedekleme (§16). Sayılar §19.12'de kesinleşecek; bunlar çalışır varsayılanlar.
MAYEN_BACKUP_DIR=backups
MAYEN_BACKUP_KEEP=7
MAYEN_BACKUP_INTERVAL_MINUTES=360
