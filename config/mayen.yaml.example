# Mayen config örneği (ARCHITECTURE §14). Kopyalayıp `mayen.yaml` adıyla düzenleyin.
# Göreli yollar bu dosyanın bulunduğu klasöre göredir. Gizli bilgiler buraya yazılmaz:
# yalnızca tutuldukları ortam değişkeninin adı geçer.
# Etkin model ortamdan seçilir: MAYEN_MODEL=<aşağıdaki models anahtarlarından biri>

storage:
  path: ~/.local/share/mayen/mayen.db

prompts:
  system: prompts/system.txt   # rol metni (persona ve kurallar), modele giden dilde
  language: prompts/language.txt  # dil kuralı; {language} yerine konuşanın dili gelir (§8.6)

default_language: English      # tanınmayan kişiye konuşulan dil; tanınanınki profilinde (§8.6)

triggers:
  voice_priority: normal       # sesli tetikleyicinin önceliği (§5.1)
  text_priority: normal        # yazılı tetikleyicinin önceliği (§5.1)
  max_running: 1               # aynı anda süren tur sayısı (§5.2)
  settle_s: 1.0                # her şey bu kadar sessiz kalınca tur biter (§5.4)
  response_timeout_s: 20       # beklenen cevap bu sürede başlamazsa tur sessizce kapanır
  fates:                       # kesilen turun akıbeti, turu açan kaynağa göre (§5.3)
    voice: cancel
    text: restart
    timer: restart
    event: restart

confirmation:
  timeout_s: 20                # onay cevabı beklenen süre (§10.5)

loop:                          # ajan döngüsünün dış sınırı (§8.8); aşılınca model tool'suz cevaplar
  max_steps: 5                 # geçerli çağrı taşıyan cevap sayısı
  max_corrections: 2           # bütün çağrıları bozuk cevap sayısı; adım harcamaz (§9.1)

# Yazılı kanalın dinlediği adres (§7, §13). Erişim yalnızca özel ağdan: tailnet adresi ya da
# yerel makine. Cihaz kimliği Tailscale'den okunur; Tailscale'den geçmeyen bağlantı ortak
# cihazdır (§10.1).
channel:
  host: 127.0.0.1
  port: 8765

# Panel (§14): olayları ve durumu gösteren salt okunur web arayüzü. Yalnızca sahibin
# cihazından ve aşağıdaki adreslerden açılan panel bağlanır (tarayıcının Origin başlığı).
panel:
  origins:
    - http://127.0.0.1:8765      # çekirdeğin sunduğu derlenmiş panel
    - http://localhost:5173      # geliştirme sunucusu (npm run dev)
  # dist: ../panel/dist          # derlenmiş panel (npm run build); verilirse /panel/ altında sunulur

# Ses birimleri (§3): STT ve TTS kendi süreçlerinde çalışır (`services/`); burada yalnızca
# adresleri. Model ve ses dosyaları servislerin kendi config'indedir. Yalnızca yazılı kanalla
# çalışılacaksa iki bölüm de silinebilir.
stt:
  url: http://127.0.0.1:8770
  # language: en               # dinleme dili; verilmezse model kendisi bulur
  # wake:                       # wake word (§6); model STT servisinin config'inde. Yoksa her
  #   threshold: 0.5            # söz tur açar; varsa yalnızca wake word, süren tur ve
  #   follow_up_s: 3            # asistan sustuktan sonraki bu kadar saniyede başlayan söz
  # record_dir: kayitlar/sozler  # her sözün sesi (WAV) ve metni; izi yeniden çıkarmak için
tts:
  url: http://127.0.0.1:8771
  voices:                      # her çıkış dilinin sesi (§16.3): anahtar profildeki dil,
    English: default           # değer TTS servisinin config'indeki sesin adı
# Konuşmacı tanıma (§6), isteğe bağlı: sesin izini çıkaran servis ve izi kişiye çeviren eşik.
# Yoksa söz cihazın kişisinindir. Varsa sahibin izi `mayen voice <wav…>` ile yazılır.
# speaker:
#   url: http://127.0.0.1:8772
#   threshold: 0.50            # yer tutucu. Adaylar: 0.25 (SpeechBrain'in varsayılanı) ve 0.65
#                              # (v1); yükseği yanlış kabule, düşüğü yanlış redde karşı sıkıdır

# Kimse konuşmadan açılan turun (system rolü) yetkisi, turu açan kaynağa göre (§10.2).
# Etki sınıfı başına okunabilen/yazılabilen hassasiyetler; yazılmayan hücre kapalıdır.
system_role:
  timer: {}                    # hatırlatma metni tetikleyiciyle gelir; tool gerekmez

# Skill varsayılanlarının üzerine yazma (§9.1); tek bir kayıt için kullanıcı ayrıca söyler.
skills:
  reminder_add:
    tolerance_minutes: 30      # Mayen kapalıyken vadesi geçen hatırlatma en çok bu kadar geç çalar (§12)

# Açılabilecek uygulamalar (§9.4): ad → `.desktop` kimliği (dosya adı, uzantısız). Ad katalogda
# seçenek olur (§9.1); listede olmayan bir şey açılamaz. Boşsa `apps` tool'u kataloğa girmez.
apps: {}
#  Steam: steam
#  Dolphin: org.kde.dolphin

# Model deposu (§8.9, §8.10). Her rol her istekte kendi ayarlarını gönderir.
models:
  local:
    base_url: http://127.0.0.1:8080/v1   # OpenAI uyumlu uç
    model: my-model                      # sunucunun tanıdığı model adı
    context_tokens: 16384
    slot_field: id_slot                  # sunucu yuva seçimini bu gövde alanıyla yapıyorsa
    developer_role: true                 # şablon ortadaki geliştirici mesajını kabul ediyor mu
    thinking:
      enabled: {chat_template_kwargs: {enable_thinking: true}}
      disabled: {chat_template_kwargs: {enable_thinking: false}}
    roles:
      talker: {thinking: false, slot: 0, sampling: {temperature: 0.7}}
      reasoner: {thinking: false, slot: 1, sampling: {temperature: 0.6}}
  # cloud:
  #   base_url: https://api.example.com/v1
  #   model: some-model
  #   context_tokens: 131072
  #   api_key_env: EXAMPLE_API_KEY       # anahtarın kendisi değil, değişkenin adı
  #   roles:
  #     talker: {thinking: false}
  #     reasoner: {thinking: false}
